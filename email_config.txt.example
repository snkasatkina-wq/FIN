# Конфигурация для подключения к почте
# Скопируйте этот файл в email_config.txt и заполните своими данными

# Тип почты: mail.ru, gmail, outlook
email_type=mail.ru

# Email адрес
email_address=your_email@mail.ru

# Пароль (для mail.ru используйте обычный пароль или пароль приложения)
password=your_password

# IMAP сервер (опционально, определяется автоматически по типу почты)
# imap_server=imap.mail.ru
# imap_port=993

# Ключевые слова в теме письма (через запятую)
subject_keywords=выписка,карточка,счет,51

# Ключевые слова в адресе отправителя (через запятую, опционально)
# sender_keywords=bank.ru

# За сколько дней назад искать письма
days_back=7
