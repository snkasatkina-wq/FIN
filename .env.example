# Ключ API OpenAI (для unmarked_alert.py — сообщения о нерозмеченных операциях)
OPENAI_API_KEY=sk-your-api-key-here

# Telegram-бот для отправки уведомлений
TELEGRAM_BOT_TOKEN=your-bot-token-from-BotFather
# ID чата для получения сообщений (узнать: напишите боту /start, затем https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=your-chat-id
